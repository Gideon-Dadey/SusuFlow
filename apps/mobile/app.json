{
  "expo": {
    "name": "SusuFlow",
    "slug": "susuflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "susuflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.susuflow.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow SusuFlow to use Face ID for quick and secure sign in.",
        "NSPhotoLibraryUsageDescription": "Allow SusuFlow to access your photos so you can set a profile picture.",
        "NSCameraUsageDescription": "Allow SusuFlow to use your camera so you can take a profile picture.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.susuflow.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SusuFlow to access your photos so you can set a profile picture.",
          "cameraPermission": "Allow SusuFlow to use your camera so you can take a profile picture."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow SusuFlow to use Face ID for quick and secure sign in."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SusuFlow to use Face ID for quick and secure sign in."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#059669",
          "defaultChannel": "transactions"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a7d79a6-394e-4185-bd1f-0ab2f28da0d3"
      }
    },
    "owner": "g_ideon"
  }
}
