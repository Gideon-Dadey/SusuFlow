{
  "expo": {
    "name": "Credo",
    "slug": "credo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "credo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.credo.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Credo to use Face ID for quick and secure sign in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0056d2",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.credo.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Credo to use Face ID for quick and secure sign in."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Credo to use Face ID for quick and secure sign in."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1a365d",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#09090b"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#059669",
          "defaultChannel": "transactions"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "susuflow-mobile"
      }
    }
  }
}
