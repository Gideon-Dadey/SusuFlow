# Development
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_URL=http://localhost:3000
EXPO_PUBLIC_DEFAULT_TENANT=apex-susu
EXPO_PUBLIC_APP_ENV=development

# Production (set in EAS build env — see eas.json)
# EXPO_PUBLIC_API_URL=https://api.susuflow.com
# EXPO_PUBLIC_WEB_URL=https://susuflow.com

# EAS project UUID (also written to app.json extra.eas.projectId)
# EXPO_PUBLIC_EAS_PROJECT_ID=3a7d79a6-394e-4185-bd1f-0ab2f28da0d3

# Support contacts — phone / WhatsApp must be real numbers or Call/WhatsApp stay hidden
EXPO_PUBLIC_SUPPORT_EMAIL=gideondadey@gmail.com
EXPO_PUBLIC_SUPPORT_PHONE=+233551550530
EXPO_PUBLIC_SUPPORT_WHATSAPP=233551550530

# Crash reporting (EAS secret recommended — never commit real DSN)
# EXPO_PUBLIC_SENTRY_DSN=https://...@o....ingest.sentry.io/...

# Optional product analytics (PostHog). First-party events still POST to the API when logged in.
# EXPO_PUBLIC_ANALYTICS_KEY=

# Fixes Expo CLI crash: "Body has already been read" on start (do not use --offline on iPhone)
EXPO_NO_DEPENDENCY_VALIDATION=1
