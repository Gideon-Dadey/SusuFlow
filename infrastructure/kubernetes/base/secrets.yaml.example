# Copy to susuflow-secrets and fill with real values — never commit the actual Secret.
apiVersion: v1
kind: Secret
metadata:
  name: susuflow-secrets
  labels:
    app.kubernetes.io/part-of: susuflow
type: Opaque
stringData:
  JWT_SECRET: "replace-with-64-char-random-string"
  ENCRYPTION_KEY: "replace-with-64-char-hex-key"
  DATABASE_URL: "postgresql://user:pass@rds-host:5432/susuflow"
  REDIS_URL: "redis://elasticache-host:6379"
  SENTRY_DSN: "https://your-sentry-dsn"
  SENDGRID_API_KEY: ""
  SMS_API_KEY: ""
  HUBTEL_CLIENT_SECRET: ""
  HUBTEL_WEBHOOK_SECRET: ""
  PAYSTACK_SECRET_KEY: ""
