# Copy to terraform.tfvars and fill in values before apply
aws_region         = "eu-west-1"
aws_account_suffix = "REPLACE_ME"  # e.g. last 8 digits of AWS account ID

vpc_cidr = "10.10.0.0/16"

eks_node_desired_size = 2
rds_instance_class    = "db.t4g.medium"
redis_node_type       = "cache.t4g.micro"

web_url = "https://staging.susuflow.com"
api_url = "https://api-staging.susuflow.com"
alarm_email = "ops@susuflow.com"
