# Application
NODE_ENV=development
API_PORT=4000
# Local dev: API on :4000. Render web service: set to your API URL (e.g. https://susuflow-api.onrender.com)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TENANT=abc-susu

# Database
DATABASE_URL=postgresql://susuflow:susuflow_dev@localhost:5432/susuflow?schema=public

# Redis — local: redis://localhost:6379 | Upstash: rediss://default:TOKEN@HOST:6379
REDIS_URL=redis://localhost:6379
TENANT_CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=info

# Rate limiting (raise THROTTLE_LIMIT for load testing, e.g. 10000)
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# JWT
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (PII fields)
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-aes256

# Payment Gateways
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack webhook URL: {API_URL}/api/v1/webhooks/paystack

# AWS (production)
AWS_REGION=eu-west-1
AWS_S3_BUCKET=susuflow-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Notifications
SENDGRID_API_KEY=
SMS_API_KEY=
SMS_SENDER_ID=SusuFlow

# Super Admin seed
SUPER_ADMIN_EMAIL=admin@susuflow.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
