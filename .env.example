# Application
NODE_ENV=development
API_PORT=4000
PORT=4000
WORKER_HEALTH_PORT=4001
# Local dev: API on :4000.
# Render (frontend only): leave API_URL unset — marketing pages work without a backend.
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TENANT=abc-susu
NEXT_PUBLIC_SENTRY_DSN=

# Database
DATABASE_URL=postgresql://susuflow:susuflow_dev@localhost:5432/susuflow?schema=public

# Redis — local: redis://localhost:6379 | Upstash: rediss://default:TOKEN@HOST:6379
REDIS_URL=redis://localhost:6379
TENANT_CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=info

# Rate limiting (raise THROTTLE_LIMIT for load testing, e.g. 10000)
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# JWT
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (PII fields — AES-256-GCM; use 64-char hex in production)
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-aes256

# OTP verification
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_SEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Error monitoring (required in production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Payment Gateways
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# AWS (production)
AWS_REGION=eu-west-1
AWS_S3_BUCKET=susuflow-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Notifications
SENDGRID_API_KEY=
SENDER_EMAIL=no-reply@susuflow.com
SMS_PROVIDER=hubtel
SMS_API_KEY=
SMS_SENDER_ID=SusuFlow
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Super Admin seed (development only — never use defaults in production)
SUPER_ADMIN_EMAIL=admin@susuflow.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
